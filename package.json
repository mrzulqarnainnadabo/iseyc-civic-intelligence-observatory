{
  "name": "iseyc-civic-intelligence-observatory",
  "private": true,
  "version": "0.2.1",
  "description": "ISEYC Civic Intelligence Observatory — public evidence workspace",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node scripts/verify-community-record-schema.mjs && node scripts/verify-inec-pvc-pilot.mjs && node scripts/verify-national-snapshots.mjs",
    "validate:registry": "node scripts/validate-registry.mjs",
    "verify": "npm run validate:registry && npm run typecheck && npm test && npm run build",
    "sync:registry": "cp data/source-registry.json src/data/source-registry.json"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@svg-maps/nigeria": "^2.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=10"
  }
}
