{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iseyc.invalid/schemas/civic-record.schema.json",
  "title": "CivicRecord (contract v1.0, proposed)",
  "description": "A PUBLISHED, public-shaped record. Operator-only and personal fields must never appear. Proposed contract: not yet agreed with the Civic Mandate or Civic Brain maintainers.",
  "type": "object",
  "required": ["id", "origin", "synthetic", "title", "summary", "sector", "stateId", "kind", "reviewStatus", "publishedMonth", "institutionIds", "stages", "unknowns", "nextSteps"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "origin": { "enum": ["civic-mandate", "civic-brain", "observatory-demo"] },
    "synthetic": { "type": "boolean", "description": "Must be true for demonstration data and false for real data." },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "sector": { "enum": ["education", "health", "security", "infrastructure", "water-sanitation", "employment", "public-finance", "governance"] },
    "stateId": { "type": "string", "description": "Lower-case slug from the Observatory state list (for example 'kaduna', 'fct')." },
    "lga": { "type": "string" },
    "kind": { "const": "community-submission" },
    "reviewStatus": { "const": "published" },
    "publishedMonth": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
    "institutionIds": { "type": "array", "items": { "type": "string" } },
    "stages": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        { "$ref": "#/$defs/stage", "properties": { "stage": { "const": "published" } } },
        { "$ref": "#/$defs/stage", "properties": { "stage": { "const": "referred" } } },
        { "$ref": "#/$defs/stage", "properties": { "stage": { "const": "announced" } } },
        { "$ref": "#/$defs/stage", "properties": { "stage": { "const": "funded" } } },
        { "$ref": "#/$defs/stage", "properties": { "stage": { "const": "implemented" } } },
        { "$ref": "#/$defs/stage", "properties": { "stage": { "const": "verified" } } }
      ]
    },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "nextSteps": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "required": ["stage", "status"],
      "additionalProperties": false,
      "properties": {
        "stage": { "enum": ["published", "referred", "announced", "funded", "implemented", "verified"] },
        "status": { "enum": ["evidenced", "claimed", "unknown", "not-reached"] },
        "evidenceId": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "origin": { "const": "observatory-demo" } } },
      "then": { "properties": { "synthetic": { "const": true } } }
    }
  ]
}
