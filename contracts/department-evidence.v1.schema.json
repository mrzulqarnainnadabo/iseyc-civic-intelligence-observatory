{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://iseyc.org/contracts/department-evidence.v1.schema.json",
  "title":"ISEYC DepartmentEvidence v1","type":"object","additionalProperties":false,
  "required":["departmentId","indicatorId","sourceId","publisher","sourceUrl","referencePeriod","retrievedAt","geography","value","unit","evidenceStatus","limitations"],
  "properties":{
    "departmentId":{"enum":["education","health","software-technology","civic"]},
    "indicatorId":{"type":"string","minLength":1},"sourceId":{"type":"string","minLength":1},
    "publisher":{"type":"string"},"sourceUrl":{"type":"string","format":"uri"},
    "referencePeriod":{"type":"string"},"retrievedAt":{"type":"string","format":"date-time"},
    "geography":{"type":"object","additionalProperties":false,"required":["level","code","label"],
      "properties":{"level":{"enum":["national","state","lga","ward","facility"]},"code":{"type":["string","null"]},"label":{"type":"string"}}},
    "value":{"type":["number","null"]},"unit":{"type":["string","null"]},
    "evidenceStatus":{"enum":["integrated","partial","unavailable","not-integrated"]},
    "limitations":{"type":"array","items":{"type":"string"}}
  }
}
