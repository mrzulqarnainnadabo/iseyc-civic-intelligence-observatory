    {"legacyLabel": "Health & Basic Services", "dutyId": "Health", "relationshipType": "legacy-alias", "mappingVersion": "1.0.0", "source": "LEGACY_DUTY_MAP"},
    {"legacyLabel": "Electricity & Infrastructure", "dutyId": "Power", "relationshipType": "legacy-alias", "mappingVersion": "1.0.0", "source": "LEGACY_DUTY_MAP"}
  ]
}
